<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ملحمتي | منظومة إدارة اللحوم</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="app">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-icon">
            <i class="fa-solid fa-drumstick-bite"></i>
          </div>
          <div>
            <h2>ملحمتي</h2>
            <p>منظومة إدارة اللحوم</p>
          </div>
        </div>

        <p class="menu-title">القائمة الرئيسية</p>

        <a href="/skow829o9" class="nav-link active">
          <i class="fa-solid fa-house"></i> الرئيسية
        </a>

        <a href="?sales=1" class="nav-link">
          <i class="fa-solid fa-cash-register"></i> المبيعات
        </a>

        <a href="/categories" class="nav-link" data-feature="الأصناف">
          <i class="fa-solid fa-cubes"></i> الأصناف
        </a>

        <a href="#" class="nav-link">
          <i class="fa-solid fa-file-invoice-dollar"></i>
          <span>الديون</span>
        </a>

        <div class="sidebar-footer">
          <i class="fa-solid fa-circle-check" style="color: #16845b"></i>
          <strong style="color: #33443a">ملحمتي</strong><br />
          واجهة إدارة المبيعات
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="welcome">
            <h1>مرحباً بك 👋</h1>
            <p>إليك ملخص حركة المبيعات في ملحمتك.</p>
          </div>

          <div class="top-actions">
            <div class="date-box">
              <i class="fa-regular fa-calendar"></i>
              <span id="todayDate"></span>
            </div>

            <div class="profile">
              <div class="avatar"><i class="fa-solid fa-user"></i></div>
              <div class="profile-info">
                <strong>مدير الملحمة</strong>
                <small>المسؤول الرئيسي</small>
              </div>
            </div>
          </div>
        </header>

        <section class="page-heading">
          <div>
            <h2>لوحة المبيعات</h2>
            <p>تابع مبيعاتك وحركة البيع اليومية.</p>
          </div>

          <button class="btn btn-primary" id="openModal">
            <i class="fa-solid fa-plus"></i>
            إضافة بيع جديد
          </button>
        </section>

        <section class="stats">
          <article class="stat-card">
            <div class="stat-top">
              <span class="stat-label">إجمالي مبيعات اليوم</span>
              <div class="stat-icon green">
                <i class="fa-solid fa-money-bill-wave"></i>
              </div>
            </div>
            <div class="stat-value" id="totalSales"><%= totalSaleCounter?.[0]?.totalSales ?? "0.00" %> <span>د.ل</span></div>
          </article>

          <article class="stat-card">
            <div class="stat-top">
              <span class="stat-label">عدد عمليات البيع اليوم</span>
              <div class="stat-icon blue">
                <i class="fa-solid fa-receipt"></i>
              </div>
            </div>
            <div class="stat-value" id="salesCount"><%= totalSale %></div>
          </article>
        </section>

        <section class="sales-panel" id="sales">
          <div class="panel-header">
            <div>
              <p>جميع عمليات البيع المسجلة لهذا اليوم.</p>
            </div>
             <%
    const query = (typeof searchQuery !== "undefined" ? searchQuery : "").trim().toLowerCase();
    const payment = typeof selectedPayment !== "undefined" ? selectedPayment : "";

    const list = (total || []).filter((sale) => {
        const matchesQuery =
            (sale.id || "").toLowerCase().includes(query) ||
            String(sale.qye || "").toLowerCase().includes(query) ||
            (sale.product || "").toLowerCase().includes(query);

        return matchesQuery && (!payment || sale.payment === payment);
    });
%>
            <span class="sales-count" id="tableCount"><%= list.length %> عملية</span>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>رقم الفاتورة</th>
                  <th>الصنف</th>
                  <th>عدد</th>
                  <th>سعر</th>
                  <th>طريقة الدفع</th>
                  <th>الوقت</th>
                
                </tr>
              </thead>
    <tbody id="salesTable">
        <% if (!list.length) { %>
            <tr>
                <td colspan="6">
                    <div class="empty">
                        <!-- <i class="fa-solid fa-receipt"
                           style="font-size:28px;margin-bottom:12px"></i> -->
                        <p>لا توجد مبيعات لعرضها</p>
                    </div>
                </td>
            </tr>
        <% } else { %>
            <% list.forEach((sale) => { %>
                <tr>
                    <td><%= sale.uuid %></td>
                    <td><%= sale.name %></td>
                    <td><%= sale.qye %></td>
                    <td><%= sale.price %></td>
                    <td><%= sale.payment %></td>
                    <td><%= sale.createdAt ? new Date(sale.createdAt).toLocaleTimeString("ar-LY", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: true
}): "" %></td>
                </tr>
            <% }) %>
        <% } %>
    </tbody>
            </table>
          </div>

          <div class="table-footer">
            <span id="tableInfo">البرمجة و التطوير : عبدالمهيمن</span>
            <span>ملحمتي © 2026</span>
          </div>
        </section>
      </main>
    </div>

    <!-- نافذة إضافة عملية بيع -->

    <div class="modal" id="saleModal">
      <div class="modal-card">
        <div class="modal-header">
          <h3>
            <i class="fa-solid fa-cart-plus" style="color: #16845b"></i> إضافة
            عملية بيع / شراء
          </h3>
          <button class="close-btn" id="closeModal" aria-label="إغلاق">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <form class="form" id="saleForm">
          <div class="form-grid">
        <div class="field full">
    <label class="customer">حدد نوع المعاملة</label>
        <div class="transaction-type">
            <button type="button" class="sale active" data-type="sale">
                بيع
            </button>

            <button type="button" class="buying" data-type="buying">
                شراء
            </button>
        </div>
        </div>
            <!-- يظهر في حالة البيع -->
          <div class="field product sale-field">
              <label for="product">نوع اللحوم</label>

              <select id="product" name="product" required>
                  <option value="">اختر الصنف</option>
                  <option value="دجاج">دجاج</option>

                  <% Category.forEach((category) => { %>
                      <option value="<%= category.name %>">
                          <%= category.name %>
                      </option>
                  <% }) %>
              </select>
          </div>

          <!-- يظهر في حالة الشراء -->
          <div class="field product buying-field" hidden>
              <label for="buyingProduct">ادخل اسم الشيء الذي اشتريته</label>

              <input
                  type="text"
                  id="buyingProduct"
                  name="buyingProduct"
                  placeholder="مثال: مكنسة"
                  disabled
                  required
              >
          </div>
            <div class="field">
              <label for="weight">عدد</label>
              <input
                type="number"
                id="weight"
                min="0.01"
                max="10000"
                step="0.01"
                placeholder="مثال: 2.5"
                required
              />
            </div>

            <div class="field">
              <label for="price">سعر (د.ل)</label>
              <input
                type="number"
                id="price"
                min="0.01"
                max="1000000"
                step="0.01"
                placeholder="مثال: 35"
                required
              />
            </div>

            <div class="field">
              <label for="payment">طريقة الدفع</label>
              <select id="payment" required>
                <option value="نقدي">نقدي</option>
                <option value="بطاقة">بطاقة</option>
                <option value="تحويل">تحويل</option>
              </select>
            </div>
          </div>

          <!-- <div class="total-box">
            <span>إجمالي قيمة البيع</span>
            <strong id="saleTotal">0.00 د.ل</strong>
          </div> -->

          <div class="form-buttons">
            <button type="submit" class="btn btn-primary">
              <i class="fa-solid fa-check"></i> تأكيد البيع
            </button>

            <button type="button" class="btn btn-cancel" id="cancelModal">
              إلغاء
            </button>
          </div>
        </form>
      </div>
    </div>

    <div class="toast" id="toast"></div>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/index.js"></script>
</html>
