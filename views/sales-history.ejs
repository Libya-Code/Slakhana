<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ملحمتي | منظومة إدارة اللحوم</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <div class="app">
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-icon">
            <i class="fa-solid fa-drumstick-bite"></i>
          </div>
          <div>
            <h2>ملحمتي</h2>
            <p>منظومة إدارة اللحوم</p>
          </div>
        </div>

        <p class="menu-title">القائمة الرئيسية</p>

        <a href="/skow829o9" class="nav-link">
          <i class="fa-solid fa-house"></i> الرئيسية
        </a>

        <a href="?sales=1" class="nav-link active">
          <i class="fa-solid fa-cash-register"></i> المبيعات
        </a>

        <a href="/categories" class="nav-link" data-feature="الأصناف">
          <i class="fa-solid fa-cubes"></i> الأصناف
        </a>

        <a href="#" class="nav-link">
          <i class="fa-solid fa-file-invoice-dollar"></i>
          <span>الديون</span>
        </a>

        <div class="sidebar-footer">
          <i class="fa-solid fa-circle-check" style="color: #16845b"></i>
          <strong style="color: #33443a">ملحمتي</strong><br />
          واجهة إدارة المبيعات
        </div>
      </aside>

      <main class="main">
        <header class="topbar">
          <div class="welcome">
            <h1> <%= "name" ?? '' %>مرحباً بك 👋</h1>
            <p>إليك ملخص حركة المبيعات في ملحمتك.</p>
          </div>

          <div class="top-actions">
            <div class="date-box">
              <i class="fa-regular fa-calendar"></i>
              <span id="todayDate"></span>
            </div>

            <div class="profile">
              <div class="avatar"><i class="fa-solid fa-user"></i></div>
              <div class="profile-info">
                <strong>مدير الملحمة</strong>
                <small>المسؤول الرئيسي</small>
              </div>
            </div>
          </div>
        </header>

        <section class="stats">
          <article class="stat-card">
            <div class="stat-top">
              <span class="stat-label">إجمالي مبيعات</span>
              <div class="stat-icon green">
                <i class="fa-solid fa-money-bill-wave"></i>
              </div>
            </div>
            <div class="stat-value" id="totalSales"><%= totalSaleCounter?.[0]?.totalSales ?? "0.00" %> <span>د.ل</span></div>
          </article>

          <article class="stat-card">
            <div class="stat-top">
              <span class="stat-label">عدد عمليات البيع اليوم</span>
              <div class="stat-icon blue">
                <i class="fa-solid fa-receipt"></i>
              </div>
            </div>
            <div class="stat-value" id="salesCount"><%= totalSale %></div>
          </article>
        </section>
         <%
    const query = (typeof searchQuery !== "undefined" ? searchQuery : "").trim().toLowerCase();
    const payment = typeof selectedPayment !== "undefined" ? selectedPayment : "";
                const list = (total || []).filter((sale) => {
                    const matchesQuery =
                        (sale.id || "").toLowerCase().includes(query) ||
                        String(sale.qye || "").toLowerCase().includes(query) ||
                        (sale.product || "").toLowerCase().includes(query);

                    return matchesQuery && (!payment || sale.payment === payment);
                });
            %>
        <section class="sales-panel" id="sales">
            <div class="content-Data">
                <button type="submit">بحث</button>
                <div class="sales-Data">
                    <p>  من تاريخ </p>
                    <input type="date" id="Date1">
                    <p>  الي تاريخ  </p>
                    <input type="date" id="Date2">
                </div>
                
            </div>
          <div class="panel-header">
            <div>
              <!-- <h3>مبيعاتك</h3> -->
              <p>جميع عمليات البيع المسجلة من تاريخ <%= "2006" %> الي تاريخ <%= "2026" %></p>
            </div>
            <span class="sales-count" id="tableCount"><%= list.length %> عملية</span>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>رقم الفاتورة</th>
                  <th>الموضف</th>
                  <th>الصنف</th>
                  <th>عدد</th>
                  <th>الإجمالي</th>
                  <th>طريقة الدفع</th>
                  <th>الوقت</th>
                  <th>التاريخ</th>
                  <th>نوع</th>
                  <th>الإجراءات</th>
                </tr>
              </thead>
<tbody id="salesTable">
    <% if (!list.length) { %>
        <tr>
            <td colspan="10">
                <div class="empty">
                    <!-- <i class="fa-solid fa-receipt"
                       style="font-size:28px;margin-bottom:12px"></i> -->
                    <p>لا توجد مبيعات لعرضها</p>
                </div>
            </td>
        </tr>
    <% } else { %>
        <% list.forEach((sale) => { %>
            <tr>
                <td><%= sale.uuid %></td>
                <td><%= sale.employeeName ?? "غير معرف" %></td>
                <td><%= sale.name %></td>
                <td><%= sale.qye %></td>
                <td><%= sale.price %></td>
                <td><%= sale.payment %></td>

                <td>
                    <%= sale.createdAt ? new Date(sale.createdAt).toLocaleTimeString("ar-LY", {
                        hour: "2-digit",
                        minute: "2-digit",
                        hour12: true
                    }) : "" %>
                </td>

                <td>
                    <%= new Date(sale.createdAt).toLocaleDateString("en-CA") %>
                </td>
                <td>
                  <span class="<%= sale?.status ? 'Sale' : 'Purchase' %>">
                    <%= sale?.status ? "بيع" : "شراء" %>
                  </span>
                </td>

                <!-- الإجراءات -->
                <td>
                    <div class="table-actions">
                        <button
                            type="button"
                            class="btn-print"
                            data-uuid="<%= sale._id %>"
                            title="طباعة">
                            <i class="fa-solid fa-print"></i>
                        </button>

                        <button
                            type="button"
                            class="btn-delete"
                            data-uuid="<%= sale._id %>"
                            title="حذف">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        <% }) %>
    <% } %>
</tbody>
            </table>
          </div>

          <div class="table-footer">
            <span id="tableInfo">برمجة و تطوير : عبدالمهيمن</span>
            <span>ملحمتي © 2026</span>
          </div>
        </section>
      </main>
    </div>

    <div class="toast" id="toast"></div>
  </body>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <script src="/js/sales-history.js"></script>
</html>
