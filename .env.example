# انسخ هذا الملف إلى .env وضع القيم الحقيقية (لا ترفع .env إلى Git أبدًا)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME
# مفتاح عشوائي طويل (32+ حرفًا). مثال للتوليد: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_JWT=
NODE_ENV=production
# النطاق الوحيد المسموح له بإرسال طلبات للـAPI
ALLOWED_ORIGIN=https://your-domain.example
# فعّله (true) بعد التأكد أن الاستضافة ترسل X-Forwarded-Proto
FORCE_HTTPS=false
# عدد البروكسيات أمام التطبيق (Hostinger عادةً 1)
TRUST_PROXY=1
